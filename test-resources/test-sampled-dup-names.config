//
// Positive test: duplicate file base names exist among the matched files, but
// files_per_quant_batch samples the set down to one file, so the files actually used are
// unique.
//
// The duplicate-name check must run on the SAMPLED files, not on every match. An earlier
// version checked before sampling and rejected this config, which the workflow had
// previously accepted. msconvert_only is used so the sample can be a single file without
// tripping DIA-NN's two-file minimum, which keeps the test deterministic -- a larger sample
// would depend on File.listFiles() ordering and the shuffle seed.
//
// Expected: success. dup-names-a and dup-names-b deliberately share base names.
//

params {

    msconvert_only = true

    quant_spectra_dir = ['test-resources/dup-names-a',
                         'test-resources/dup-names-b']
    quant_spectra_glob = '*.raw'
    files_per_quant_batch = 1

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
