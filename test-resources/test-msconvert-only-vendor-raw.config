//
// Negative test: msconvert_only combined with direct vendor raw reads.
//
// `msconvert_only` exists to run msconvert and exit, but `use_vendor_raw` skips msconvert, so
// the two together leave nothing to convert. Without validation the run succeeded as a no-op:
// it wrote nextflow_run_details.txt and, with panorama.upload set, uploaded the unconverted
// .raw files into results/msconvert.
//
// `msconvert.do_demultiplex` is false here so the run reaches this guard rather than the
// demultiplex guard that precedes it (see test-vendor-raw-demultiplex.config).
//
// Expected: non-zero exit before any task runs, with a message naming `msconvert_only` and
// `use_vendor_raw`. See .github/workflows/push-stub-run.yml.
//

params {

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    msconvert_only = true
    use_vendor_raw = true
    msconvert.do_demultiplex = false
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
