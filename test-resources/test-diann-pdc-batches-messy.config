//
// Positive test: a PDC batch file that is valid but untidy.
//
// The batch TSV has blank lines between rows, a trailing blank line, and batch values
// padded with spaces. All three are tolerated: blank lines are skipped and fields are
// trimmed before the batch name is validated. Before this was handled, a trailing blank
// line failed with a bare `Index 1 out of bounds for length 1`.
//
// Expected: success, with two batches (BatchA, BatchB) -- identical to the result of
// test-diann-pdc-batches.config.
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.study_name = 'test_pdc_study'
    pdc.metadata_tsv = 'test-resources/test-pdc-metadata.tsv'
    pdc.batch_file = 'test-resources/test-pdc-batch-file-messy.tsv'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    qc_report.skip = false
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
