//
// Negative test: a batch name containing a path separator.
//
// Batch names become filename components (`<document_name>_<batch>.sky.zip`), so a name
// containing '/' produces an unwritable path. Without validation the run reached
// SKYLINE_MERGE_RESULTS and failed after two retries with
// `touch: cannot touch 'final_a/b.sky.zip': No such file or directory`.
//
// Expected: non-zero exit before any task runs, with a message naming `quant_spectra_dir`
// and the offending batch name. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1': 'test-resources/narrow-window',
                         'a/b'   : 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
