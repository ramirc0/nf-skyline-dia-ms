//
// Negative test: `pdc.batch_file` set to an empty string.
//
// An empty string is not null, so it switched the run into multi-batch mode and then failed
// with `Argument of file() function cannot be empty` -- no parameter named. The empty-value
// guard in resolve_user_path() was unreachable because file() threw first.
//
// Expected: non-zero exit with a message naming `pdc.batch_file`.
// See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.study_name = 'test_pdc_study'
    pdc.metadata_tsv = 'test-resources/test-pdc-metadata.tsv'
    pdc.batch_file = ''

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
