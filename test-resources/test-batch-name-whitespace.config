//
// Positive test: batch names with surrounding whitespace are trimmed, not rejected.
//
// ' Plate1 ' and 'Plate2\t' name the batches Plate1 and Plate2. Trimming happens once in
// main.nf (normalize_batch_map) and the result feeds both get_ms_files and batch_name_list,
// so the channel keys and the Skyline document join always agree. Interior spaces are kept.
//
// Expected: success, with documents final_Plate1.sky.zip and final_Plate2.sky.zip.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = [' Plate1 ' : 'test-resources/narrow-window',
                         'Plate2\t' : 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
