//
// Negative test: two batch names that are distinct Groovy Map keys but identical once
// trimmed.
//
// Since batch names are trimmed rather than rejected, 'Plate1' and 'Plate1 ' would collapse
// onto the same batch and one directory would be silently dropped. Caught explicitly instead.
//
// Expected: non-zero exit before any task runs, naming `quant_spectra_dir` and the repeated
// batch name. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1'  : 'test-resources/narrow-window',
                         'Plate1 ' : 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
