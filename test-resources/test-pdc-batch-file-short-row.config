//
// Negative test: a PDC batch file with a row missing the `batch` column.
//
// Groovy's split() drops trailing empty fields, so indexing the batch column on a short row
// threw a bare `Index 1 out of bounds for length 1` with no mention of the file or the line.
//
// Expected: non-zero exit with a message naming `pdc.batch_file`, the 1-based line number,
// and the offending line. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    pdc.study_id = 'PDC000504'
    pdc.study_name = 'test_pdc_study'
    pdc.metadata_tsv = 'test-resources/test-pdc-metadata.tsv'
    pdc.batch_file = 'test-resources/test-pdc-batch-file-short-row.tsv'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
