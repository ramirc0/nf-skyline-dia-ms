//
// Negative test: demultiplexing requested together with direct vendor raw reads.
//
// `msconvert.do_demultiplex` adds `--filter "demultiplex optimization=overlap_only"` to the
// msconvert command, which is the only way this workflow deconvolves overlapping (staggered)
// DIA windows. `use_vendor_raw` skips msconvert entirely and hands the .raw files to DIA-NN
// and to Skyline, neither of which demultiplexes them. Without validation the run completed
// normally and silently produced results from non-demultiplexed spectra.
//
// Expected: non-zero exit before any task runs, with a message naming
// `msconvert.do_demultiplex` and `use_vendor_raw`. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = 'test-resources/wide-window'
    quant_spectra_glob = '*.raw'

    use_vendor_raw = true
    msconvert.do_demultiplex = true

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
