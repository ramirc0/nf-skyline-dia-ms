//
// Negative test: two batches resolving files with the same base names.
//
// Nextflow stages a batch's inputs into a shared directory, so duplicate file names
// collide. Without an up-front check the run got all the way to DIANN_MBR and failed with
// Nextflow's generic `input file name collision`, which does not say which parameter or
// which batches were at fault.
//
// Expected: non-zero exit before any task runs, naming `quant_spectra_dir`, the duplicated
// file names, and the batches they came from. See .github/workflows/push-stub-run.yml.
//

params {

    search_engine = 'diann'

    // Both batches point at the same directory, so every file name appears twice.
    quant_spectra_dir = ['B1': 'test-resources/wide-window',
                         'B2': 'test-resources/wide-window']
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'
    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
