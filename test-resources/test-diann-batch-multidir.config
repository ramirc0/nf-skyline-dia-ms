//
// Positive test: a batch whose value is a *list* of directories.
//
// `quant_spectra_dir` may map a batch name to either a single directory or a list of
// directories; get_ms_files flattens the value with param_to_list. The schema allows both
// shapes. All matched files must still share one extension and have unique base names.
//
// Expected: success, one Skyline document named final_Plate1.sky.zip built from all six
// .raw files across both directories.
//

params {

    search_engine = 'diann'

    quant_spectra_dir = ['Plate1': ['test-resources/narrow-window',
                                    'test-resources/wide-window']]
    quant_spectra_glob = '*.raw'

    fasta = 'test-resources/test.fasta'

    msconvert.do_demultiplex = false
    msconvert.do_simasspectra = true

    qc_report.skip = true
}

profiles {
    standard {
        process {
            resourceLimits = [cpus: 2, memory: '4.GB', time: '1.h']
        }

        params.mzml_cache_directory = './mzml_cache'
        params.panorama_cache_directory = './raw_cache'
    }
}
